# The workflow uses the selected source checkout as the build context.
FROM ghcr.io/astral-sh/uv:0.13.7@sha256:96f40d3904aad8d0bd010539001d36c8e2188b981e1334471a90c4a1d93bb490 AS uv
FROM python:3.12.16-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df AS build
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
ENV UV_PYTHON_DOWNLOADS=never UV_NO_CACHE=1 UV_CONCURRENT_BUILDS=1 UV_CONCURRENT_INSTALLS=4
COPY pyproject.toml uv.lock README.md ./
COPY src/ src/
ARG SOURCE_VERSION
ENV SETUPTOOLS_SCM_PRETEND_VERSION_FOR_VLLM_ROUTER=${SOURCE_VERSION}

# Export only the source lock's runtime graph. Extract its build backend graph
# separately so no isolated build can download unpinned backend dependencies.
RUN test -n "$SOURCE_VERSION" && \
    uv export --locked --no-dev --no-default-groups --no-emit-project --output-file /app/runtime.txt && \
    uv venv /opt/venv
RUN python - <<'PY'
import tomllib
from pathlib import Path
lock = tomllib.loads(Path('uv.lock').read_text())
packages = {}
for package in lock['package']:
    packages.setdefault(package['name'], []).append(package)
pending = ['setuptools', 'setuptools-scm']
selected = {}
while pending:
    name = pending.pop()
    if name in selected:
        continue
    candidates = packages.get(name, [])
    if len(candidates) != 1:
        raise SystemExit(f'Missing or ambiguous locked build dependency: {name}')
    package = candidates[0]
    if package.get('source') != {'registry': 'https://pypi.org/simple'}:
        raise SystemExit(f'Unsupported build dependency source: {name}')
    selected[name] = package
    for dependency in package.get('dependencies', []):
        if 'marker' in dependency:
            raise SystemExit(f'Unsupported conditional build dependency: {name}')
        pending.append(dependency['name'])
lines = []
for name, package in sorted(selected.items()):
    hashes = sorted({wheel['hash'] for wheel in package.get('wheels', [])})
    if not hashes:
        raise SystemExit(f'Build tooling must have locked wheels: {name}')
    lines.append(f"{name}=={package['version']} " + ' '.join(f'--hash={value}' for value in hashes))
Path('/app/backend.txt').write_text('\n'.join(lines) + '\n')
PY
RUN uv pip install --python /opt/venv/bin/python --require-hashes --only-binary :all: --no-deps -r backend.txt && \
    uv pip install --python /opt/venv/bin/python --require-hashes --no-build-isolation --no-deps -r runtime.txt && \
    uv pip install --python /opt/venv/bin/python --no-deps --no-build-isolation .

FROM python:3.12.16-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df
WORKDIR /app
COPY --from=build /opt/venv /opt/venv
ENTRYPOINT ["/opt/venv/bin/vllm-router"]
CMD []

# The workflow uses the selected source's operator/ directory as context.
FROM golang:1.24.9-bookworm@sha256:737b40b61ce956d738bed59f18ba854d8d67e7a4c4fa63f64437f4c70247ac5b AS builder
ARG TARGETOS=linux
ARG TARGETARCH=amd64
ENV GOTOOLCHAIN=local GOFLAGS=-mod=readonly GOMAXPROCS=2
WORKDIR /workspace
COPY go.mod go.sum ./
# Fail if downloading dependencies would change the selected source manifests.
RUN cp go.mod /tmp/go.mod && cp go.sum /tmp/go.sum && \
    go mod download && go mod verify && \
    cmp go.mod /tmp/go.mod && cmp go.sum /tmp/go.sum
COPY cmd/main.go cmd/main.go
COPY api/ api/
COPY internal/ internal/
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -p 2 -a -o manager cmd/main.go && \
    cmp go.mod /tmp/go.mod && cmp go.sum /tmp/go.sum
FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
WORKDIR /
COPY --from=builder /workspace/manager /manager
USER 65532:65532
ENTRYPOINT ["/manager"]
